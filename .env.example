# Public absolute URL. Used for sitemap, Open Graph and canonical URLs.
APP_URL=https://autozapchast-taldom.ru

# Runtime mode. PM2 also sets this explicitly in ecosystem.config.cjs.
NODE_ENV=production

# PostgreSQL.
DATABASE_URL=postgresql://autozap_user:CHANGE_ME@localhost:5432/autozap

# Absolute project root shared by the standalone web process and import worker.
IMPORT_STORAGE_ROOT=/var/www/autozap

# Meilisearch. Keep Meilisearch bound to localhost or a private network.
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=CHANGE_ME_LONG_RANDOM_MEILI_MASTER_KEY
MEILI_SEARCH_KEY=

# Admin session signing secret. Use at least 32 random characters.
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SESSION_SECRET_AT_LEAST_32_CHARS

# Existing Yandex Metrika counter. Keep analytics OFF until separately approved
# counter settings, consent registration and SDK checks are complete.
YANDEX_METRIKA_COUNTER_ID=113668070
YANDEX_METRIKA_CONFIGURATION_VERIFIED=false

# Separate server-only signing secret for privacy receipts: at least 32 random
# characters. Empty disables production consent acceptance. Set it securely on
# the server, keep it stable, never expose via NEXT_PUBLIC_ or commit a real .env.
PRIVACY_CONSENT_SECRET=

# Optional. If empty, the site shows the Yandex map fallback with route buttons.
YANDEX_MAPS_API_KEY=
