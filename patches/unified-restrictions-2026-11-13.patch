@@ -0,0 +1,84 @@
+import assert from "node:assert/strict";
+import { randomUUID } from "node:crypto";
+import { spawn } from "node:child_process";
+import { createFinalPolicyFixture } from "./helpers/final-public-policy-fixture";
+import { DISPUTED_GAZ_PRODUCT_SLUGS } from "../src/features/publication-policy/restricted-brands";
+import { LEGACY_PUBLICATION_POLICY_VERSION, PUBLICATION_POLICY_VERSION } from "../src/features/publication-policy/rules";
+import { ALL_ASSORTMENT_CATEGORY_SLUG, ALL_PRODUCTS_SUBCATEGORY_SLUG } from "../src/config/public-taxonomy";
+
+async function main() {
+  const f = await createFinalPolicyFixture();
+  const { admin } = f;
+  try {
+    const catalog = await import("../src/features/catalog/data");
+    const { activatePublicPolicy } = await import("../src/features/publication-policy/public-activation");
+    const imports = await import("../src/features/admin/imports");
+    const { searchProducts } = await import("../src/features/search/service");
+    const { syncSearchIndexForActiveCatalog } = await import("../src/features/search/indexing");
+    const { getActiveCatalogSitemapRows } = await import("../src/features/admin/backups/service");
+    const count = async () => (await catalog.getProductsForSubcategory(ALL_ASSORTMENT_CATEGORY_SLUG, ALL_PRODUCTS_SUBCATEGORY_SLUG)).pagination.totalItems;
+    const base = await count();
+    const labels = ["Фара ГАЗ", "Фара НАЗ", "Фара КАМАЗ", "Фильтр Hyundai", "Фильтр Kia", "Клапан WABCO", "Фара BMW", "Фара Mitsubishi", "Масло Лукойл"];
+    const retained = ["Фара МАЗ", "Фара ЗАЗ", "Фара ПАЗ", "Фара ЛиАЗ", "Фара КАвЗ"];
+    const rows = [
+      ...labels.map((name, i) => ({ name, slug: `unified-${i}` })),
+      ...DISPUTED_GAZ_PRODUCT_SLUGS.map(slug => ({ name: "Деталь ГАЗ", slug })),
+      ...retained.map((name, i) => ({ name, slug: `scope-retained-${i}` }))
+    ].map((row, i) => ({ ...row, id: randomUUID(), catalog_version_id: f.version,
+      product_identity_id: randomUUID(), shop_code: `УН-${i + 1}`, raw_name: `УН-${i + 1} ${row.name}`,
+      category_id: f.category, subcategory_id: f.subcategory, search_text: row.name, price: 100 }));
+    await admin`INSERT INTO product_identities ${admin(rows.map(row => ({ id: row.product_identity_id })), "id")}`;
+    await admin`INSERT INTO products ${admin(rows)}`;
+    await activatePublicPolicy(f.version, f.owner);
+    assert.equal(await count(), base + retained.length);
+    for (const row of rows.slice(0, labels.length + DISPUTED_GAZ_PRODUCT_SLUGS.length)) {
+      assert.equal(await catalog.getProductDetails(f.target.categorySlug, f.target.subcategorySlug, row.slug), null);
+    }
+    assert.equal((await catalog.getProductsForPurchaseList(rows.map(row => row.product_identity_id))).length, retained.length);
+
+    // Model installation over the real previous assessment format, not a blanket
+    // disabled-policy mode: old ALLOWED must still respect the existing brand gate.
+    await admin`UPDATE site_settings SET value=jsonb_set(value,'{policyVersion}',${admin.json(LEGACY_PUBLICATION_POLICY_VERSION)})
+      WHERE key='publication-policy:activation'`;
+    await admin`UPDATE products SET publication_assessment=publication_assessment || jsonb_build_object(
+      'policyVersion',${LEGACY_PUBLICATION_POLICY_VERSION}::text,'status','ALLOWED','state','ready',
+      'inputSignature',md5(jsonb_build_array(id,name,raw_name,shop_code,product_identity_id)::text))
+      WHERE id=ANY(${rows.slice(0,labels.length).map(row=>row.id)}::uuid[])`;
+    assert.equal(await count(), base + retained.length);
+    await activatePublicPolicy(f.version, f.owner);
+
+    await assert.rejects(f.decide(rows[0].id, "allow", f.manager));
+    await f.decide(rows[0].id, "allow");
+    assert.equal(await count(), base + retained.length + 1);
+    assert.ok(await catalog.getProductDetails(f.target.categorySlug, f.target.subcategorySlug, rows[0].slug));
+    await syncSearchIndexForActiveCatalog();
+    const found = await searchProducts({ query: rows[0].name, limit: 50 });
+    assert.equal(found.source, "meilisearch", "Current owner-approved brand documents must not force legacy fallback");
+    assert.ok(found.hits.some(hit => hit.productIdentityId === rows[0].product_identity_id));
+    assert.equal((await getActiveCatalogSitemapRows()).products.length, base + retained.length + 1);
+
+    const run = () => new Promise<void>((resolve, reject) => {
+      const child = spawn(process.execPath, ["--import", "tsx", "scripts/final-policy-worker-child.ts"], { env: process.env, stdio: ["ignore", "pipe", "pipe"] });
+      let error = ""; child.stderr.on("data", chunk => { error += chunk; }); child.stdout.resume();
+      const timer = setTimeout(() => { child.kill("SIGTERM"); reject(new Error("Synthetic worker timed out")); }, 60000);
+      child.once("error", reject); child.once("exit", code => { clearTimeout(timer); code === 0 ? resolve() : reject(new Error(error || `Synthetic worker exited ${code}`)); });
+    });
+    const uploaded = await imports.enqueueAdminImportFromUpload({
+      file: new File([new Uint8Array(f.workbook(101, [...f.seed, ...rows]))], "unified-restrictions.xlsx", { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" }), adminUserId: f.owner
+    });
+    await run();
+    const [batch] = await admin`SELECT * FROM import_batches WHERE id=${uploaded.importBatchId}`;
+    assert.equal(batch.status, "analyzed");
+    assert.equal(batch.report.publicationAnalysis.policyVersion, PUBLICATION_POLICY_VERSION);
+    assert.equal(batch.report.publicationAnalysis.summary.manuallyAllowed, 2);
+    const publication = await imports.enqueueAdminImportPublish({ importBatchId: uploaded.importBatchId, adminUserId: f.owner });
+    await run();
+    const [job] = await admin`SELECT status FROM background_jobs WHERE id=${publication.backgroundJobId}`;
+    assert.equal(job.status, "succeeded");
