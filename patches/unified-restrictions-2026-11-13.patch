+++ b/scripts/test-unified-restrictions.ts
@@ -0,0 +1,75 @@
+import assert from "node:assert/strict";
+import { createHash, randomUUID } from "node:crypto";
+import { test } from "node:test";
+import { assessAutomaticPublication, assessPublicationProduct, preparePublicationProduct } from "../src/features/publication-policy/assessment";
+import { LEGACY_PUBLICATION_POLICY_VERSION, PUBLICATION_POLICY_VERSION } from "../src/features/publication-policy/rules";
+import { DISPUTED_GAZ_PRODUCT_SLUGS } from "../src/features/publication-policy/restricted-brands";
+import type { CurrentPublicationDecision, PublicationProductInput } from "../src/features/publication-policy/types";
+import { classifyDraftPublicationRows, prepareDraftPublicationRows, type PublicationDraftRow } from "../src/features/import/publication-analysis";
+
+function allowance(input: PublicationProductInput): CurrentPublicationDecision {
+  const prepared = preparePublicationProduct(input);
+  const automatic = assessAutomaticPublication(prepared);
+  return { id: randomUUID(), shopCode: prepared.shopCode, productIdentityId: prepared.productIdentityId,
+    action: "allow", contentFingerprint: prepared.contentFingerprint, basisFingerprint: automatic.basisFingerprint,
+    policyVersion: PUBLICATION_POLICY_VERSION, reason: "Подтверждено владельцем", revision: 1,
+    updatedBy: randomUUID(), updatedAt: new Date() };
+}
+
+for (const name of ["Фара LADA", "Фара ГАЗ-3302", "Ручка Газель", "Фара НАЗ", "Фара КАМАЗ",
+  "Фильтр Hyundai", "Фильтр Kia Rio", "Клапан WABCO", "Фара BMW", "Фара Mitsubishi", "Масло Лукойл"])
+  test(`one import policy and explicit owner allowance: ${name}`, () => {
+    const row = { name, shopCode: "TEST-01", productIdentityId: randomUUID() };
+    assert.equal(assessPublicationProduct(row).status, "AUTO_EXCLUDED");
+    const decision = allowance(row);
+    assert.equal(assessPublicationProduct(row, [decision]).status, "ALLOWED");
+    assert.equal(assessPublicationProduct({ ...row, name: name + " другой товар" }, [decision]).status, "AUTO_EXCLUDED");
+  });
+
+for (const name of ["Трос газа УАЗ", "Фара МАЗ", "Фара ЗАЗ", "Фара ПАЗ", "Фара ЛиАЗ", "Фара КАвЗ", "Газонокосилка"])
+  test(`scope remains as selected by the owner: ${name}`, () => {
+    assert.equal(assessPublicationProduct({ name }).status, "ALLOWED");
+  });
+
+test("all complained routes are included in the shared assessment even after a title change", () => {
+  for (const slug of DISPUTED_GAZ_PRODUCT_SLUGS) {
+    const row = { name: "Переименованная деталь", rawName: "Деталь", slug, shopCode: "TEST-01" };
+    assert.equal(assessPublicationProduct(row).status, "AUTO_EXCLUDED");
+    assert.equal(assessPublicationProduct(row, [allowance(row)]).status, "ALLOWED");
+  }
+});
+
+test("raw source names and routes participate even when the visible title does not", () => {
+  assert.equal(assessPublicationProduct({ name: "Фара", rawName: "Фара Hyundai" }).status, "AUTO_EXCLUDED");
+  assert.equal(assessPublicationProduct({ name: "Фара", slug: "headlight-kia-rio" }).status, "AUTO_EXCLUDED");
+});
+
+test("an unchanged AvtoVAZ owner allowance survives the policy upgrade; new restricted evidence does not", () => {
+  const row = { name: "Фара Веста", shopCode: "TEST-01" };
+  const decision = allowance(row);
+  const automatic = assessAutomaticPublication(preparePublicationProduct(row));
+  decision.policyVersion = LEGACY_PUBLICATION_POLICY_VERSION;
+  decision.basisFingerprint = createHash("sha256").update(JSON.stringify([
+    LEGACY_PUBLICATION_POLICY_VERSION, decision.shopCode, automatic.status, automatic.evidence
+  ])).digest("hex");
+  assert.equal(assessPublicationProduct(row, [decision]).status, "ALLOWED");
+  assert.equal(assessPublicationProduct({ ...row, slug: "headlight-kia" }, [decision]).status, "AUTO_EXCLUDED");
+});
+
+test("each repeated Excel analysis preserves an owner's explicit decision and blocks new restricted rows", () => {
+  const identity = randomUUID();
+  const rows: PublicationDraftRow[] = ["Фара ГАЗ", "Фара LADA", "Фильтр Hyundai", "Лампа H7"].map((name, i) => ({
+    id: randomUUID(), rowNumber: i + 1, name, rawName: name, shopCode: `TEST-${i}`,
+    productIdentityId: i === 0 ? identity : randomUUID(), productId: randomUUID(),
+    validationStatus: "valid", price: "100", eligibleUnderExistingRules: true
+  }));
+  const decision = allowance(rows[0]);
+  for (let run = 0; run < 2; run++) {
+    const { prepared } = prepareDraftPublicationRows(rows);
+    const result = classifyDraftPublicationRows(rows, prepared, [decision], randomUUID());
+    assert.equal(result.summary.excludedTotal, 2);
+    assert.equal(result.summary.manuallyAllowed, 1);
+    assert.equal(result.summary.wouldPublish, 2);
+    assert.equal(result.assessments[0].assessment.manualDecision?.id, decision.id);
+  }
+});
