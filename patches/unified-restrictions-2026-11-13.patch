+++ b/scripts/benchmark-unified-catalog.ts
@@ -0,0 +1,56 @@
+import assert from "node:assert/strict";
+import { mkdir, writeFile } from "node:fs/promises";
+import { createFinalPolicyFixture } from "./helpers/final-public-policy-fixture";
+import { LEGACY_PUBLICATION_POLICY_VERSION } from "../src/features/publication-policy/rules";
+import { ALL_ASSORTMENT_CATEGORY_SLUG, ALL_PRODUCTS_SUBCATEGORY_SLUG } from "../src/config/public-taxonomy";
+
+async function main() {
+  const f = await createFinalPolicyFixture();
+  try {
+    const catalog = await import("../src/features/catalog/data");
+    const { prepareVersionPublicationPolicy } = await import("../src/features/publication-policy/public-assessments");
+    const { admin } = f;
+    const base = (await catalog.getProductsForSubcategory(ALL_ASSORTMENT_CATEGORY_SLUG, ALL_PRODUCTS_SUBCATEGORY_SLUG)).pagination.totalItems;
+    await admin`WITH identities AS (INSERT INTO product_identities(id)
+      SELECT gen_random_uuid() FROM generate_series(1,25000) RETURNING id),
+      numbered AS (SELECT id,row_number() OVER () AS n FROM identities)
+      INSERT INTO products(id,catalog_version_id,product_identity_id,shop_code,name,raw_name,slug,
+        category_id,subcategory_id,search_text,price)
+      SELECT gen_random_uuid(),${f.version},id,'БЧ-'||n,
+        CASE WHEN n%5=0 THEN 'Фара ГАЗ Тест ' ELSE 'Лампа H7 Тест ' END||n,
+        CASE WHEN n%5=0 THEN 'Фара ГАЗ Тест ' ELSE 'Лампа H7 Тест ' END||n,
+        'bench-unified-'||n,${f.category},${f.subcategory},'Тест',100 FROM numbered`;
+    await admin`UPDATE products SET publication_assessment=jsonb_build_object('state','ready',
+      'policyVersion',${LEGACY_PUBLICATION_POLICY_VERSION}::text,'status','ALLOWED',
+      'inputSignature',md5(jsonb_build_array(id,name,raw_name,shop_code,product_identity_id)::text))
+      WHERE slug LIKE 'bench-unified-%'`;
+    // Planner statistics belong only to this disposable test database.
+    await admin`ANALYZE products`;
+    const readings: {mode:string; page:number; ms:number; total:number; rows:number; timedOut:boolean}[] = [];
+    async function measure(mode:string) {
+      for (const page of [1,2,1]) {
+        const start=performance.now();
+        const result=await catalog.getProductsForSubcategory(ALL_ASSORTMENT_CATEGORY_SLUG,ALL_PRODUCTS_SUBCATEGORY_SLUG,{page});
+        readings.push({mode,page,ms:Math.round(performance.now()-start),total:result.pagination.totalItems,
+          rows:result.products.length,timedOut:result.subcategory===null});
+        if(mode==='prepared') {
+          assert.equal(result.pagination.totalItems,base+20000);
+          assert.equal(result.products.length,50);
+        }
+      }
+    }
+    await measure('legacy');
+    await prepareVersionPublicationPolicy(f.version);
+    await measure('prepared');
+    const start=performance.now();
+    assert.ok(await catalog.getProductDetails(f.target.categorySlug,f.target.subcategorySlug,'bench-unified-1'));
+    const detailMs=Math.round(performance.now()-start);
+    const median=(mode:string)=>readings.filter(r=>r.mode===mode).map(r=>r.ms).sort((a,b)=>a-b)[1];
+    const result={syntheticProducts:25000,restrictedProducts:5000,expectedPublic:base+20000,
+      beforeMedianMs:median('legacy'),afterMedianMs:median('prepared'),detailMs,readings};
+    await mkdir('artifacts/unified-restrictions',{recursive:true});
+    await writeFile('artifacts/unified-restrictions/catalog-benchmark.json',JSON.stringify(result,null,2));
+    console.log(JSON.stringify(result));
+  } finally { await f.cleanup(); }
+}
+main().catch(error=>{console.error(error);process.exitCode=1;});
